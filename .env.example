# ============================================================
# DataPipeline Pro — Variáveis de ambiente
# Copie este arquivo para .env e ajuste conforme necessário:
#   cp .env.example .env
# ============================================================

# --- Banco de dados ---
# PostgreSQL (via docker-compose). Deixe vazio para forçar SQLite:
DATABASE_URL=postgresql+psycopg://datapipeline:datapipeline@localhost:5432/datapipeline

# Force SQLite (ignora o PostgreSQL): DATABASE_URL=sqlite:///data/datapipeline.db
# Para desativar o fallback automático, use: PIPELINE_DB_ONLY=postgres

# --- Fonte de dados ---
# URL da API mock local (scripts/extract.py --source api)
API_URL=http://localhost:8000

# Diretórios de dados
DATA_RAW_DIR=data/raw
DATA_PROCESSED_DIR=data/processed
DATA_QUALITY_DIR=data/quality
LOG_DIR=logs
